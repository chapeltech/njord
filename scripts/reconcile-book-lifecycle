#!/bin/sh

set -eu

cd "$(dirname "$0")/.."
. scripts/acquire-lifecycle-lock

control_database=${NJORD_CONTROL_DATABASE:-njord}
psql_bin=${PSQL:-psql}
dropdb_bin=${DROPDB:-dropdb}

books=$(
	"$psql_bin" -X -v ON_ERROR_STOP=1 -d "$control_database" -Atq -F '|' -c \
	    "SELECT id, provisioning_state FROM njord_control.books WHERE provisioning_state <> 'ready' ORDER BY id"
)

while IFS='|' read -r book state; do
	[ -n "$book" ] || continue
	if ! printf '%s\n' "$book" | grep -Eq '^[a-z][a-z0-9_-]{0,62}$'; then
		echo "Invalid Book handle in control catalogue: $book" >&2
		exit 1
	fi
	exists=$(
		"$psql_bin" -X -v ON_ERROR_STOP=1 -d postgres -Atq \
		    -c "SELECT EXISTS (SELECT 1 FROM pg_database WHERE datname = '$book')"
	)
	case "$state" in
		provisioning)
			if [ "$exists" = t ]; then
				# Creation reached the durable database. Only bless it after its
				# schema, singleton identity, and physical grants all validate.
				if NJORD_ALLOW_LEGACY_ADOPTION=1 PSQL="$psql_bin" \
				    scripts/migrate-database book "$book" >/dev/null \
				    && "$psql_bin" -X -v ON_ERROR_STOP=1 -q -d "$book" \
				        -v book_id="$book" -f sql/set-book-access.sql >/dev/null \
				    && "$psql_bin" -X -v ON_ERROR_STOP=1 -q -d "$book" \
				        -v book_id="$book" -f sql/grant-book-gateway.sql >/dev/null
				then
					"$psql_bin" -X -v ON_ERROR_STOP=1 -q -d "$control_database" \
					    -v book_id="$book" -f sql/mark-book-ready.sql >/dev/null
					echo "Recovered provisioned Book $book." >&2
				else
					# A Book is not externally visible until ready. A database
					# which cannot pass the controlled fresh-install fingerprint
					# is an incomplete create, not an existing user ledger.
					"$dropdb_bin" --if-exists --force "$book"
					"$psql_bin" -X -v ON_ERROR_STOP=1 -q -d "$control_database" \
					    -v book_id="$book" -f sql/unregister-book.sql >/dev/null
					echo "Removed incomplete Book database $book." >&2
				fi
			else
				"$psql_bin" -X -v ON_ERROR_STOP=1 -q -d "$control_database" \
				    -v book_id="$book" -f sql/unregister-book.sql >/dev/null
				echo "Removed incomplete Book catalogue entry $book." >&2
			fi
			;;
		deleting)
			if [ "$exists" = t ]; then
				"$dropdb_bin" --if-exists --force "$book"
			fi
			"$psql_bin" -X -v ON_ERROR_STOP=1 -q -d "$control_database" \
			    -v book_id="$book" -f sql/unregister-book.sql >/dev/null
			echo "Completed interrupted deletion of Book $book." >&2
			;;
		*)
			echo "Unsupported lifecycle state '$state' for Book $book." >&2
			exit 1
			;;
	esac
done <<EOF
$books
EOF
