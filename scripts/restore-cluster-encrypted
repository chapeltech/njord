#!/usr/bin/env bash

set -Eeuo pipefail

if [[ $# -ne 2 ]]; then
	echo 'usage: scripts/restore-cluster-encrypted AGE_IDENTITY_FILE ENCRYPTED_BACKUP' >&2
	exit 2
fi

identity=$1
encrypted=$2
[[ -f $identity && -r $identity ]] || {
	echo "Age identity is not a readable regular file: $identity" >&2
	exit 1
}
[[ -f $encrypted && -r $encrypted ]] || {
	echo "Encrypted backup is not a readable regular file: $encrypted" >&2
	exit 1
}

parent=/var/lib/postgresql/18
mkdir -p "$parent"
umask 077
archive=$(mktemp "$parent/.njord-decrypted.XXXXXX.tar.gz")
cleanup()
{
	status=$?
	trap - EXIT HUP INT TERM
	rm -f "$archive"
	exit "$status"
}
trap cleanup EXIT HUP INT TERM

age --decrypt --identity "$identity" --output "$archive" "$encrypted"
"$(dirname "$0")/restore-cluster" "$archive"
