#!/bin/sh

set -eu

cd "$(dirname "$0")/.."

if [ -n "${POSTGREST_BIN:-}" ]; then
    postgrest_bin=$POSTGREST_BIN
elif command -v postgrest >/dev/null 2>&1; then
    postgrest_bin=$(command -v postgrest)
elif [ -x .tools/postgrest ]; then
    postgrest_bin=.tools/postgrest
else
    echo "PostgREST is not installed. Run scripts/install-postgrest." >&2
    exit 1
fi

database=${PLUTUS_DATABASE:-finances}
database_role=${PLUTUS_DATABASE_ROLE:-${PGUSER:-$(id -un)}}

export PGRST_DB_URI=${PGRST_DB_URI:-"postgresql:///${database}"}
export PGRST_DB_ANON_ROLE=${PGRST_DB_ANON_ROLE:-$database_role}

exec "$postgrest_bin" postgrest.conf
