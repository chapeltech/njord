# Compose/image identity
NJORD_COMPOSE_PROJECT=njord
# Use an immutable version tag or registry digest for a real deployment.
NJORD_IMAGE=njord:0.1.0

# Create this external network before starting Njord and attach the separately
# managed nginx service to it as well.
NJORD_DOCKER_NETWORK=njord-edge
NJORD_NETWORK_ALIAS=njord
# The HTTP process is unprivileged; choose a container port from 1024 to 65535.
NJORD_HTTP_PORT=8080
# Used only with compose.local.yaml.
NJORD_HOST_PORT=8080

# Durable cluster identity. Do not change these after first initialization.
NJORD_CONTROL_DATABASE=njord
# Leave blank in the appliance: it becomes the first GitHub administrator's
# role when OAuth is enabled, or "njord" in unauthenticated demonstration mode.
NJORD_DATABASE_ROLE=
NJORD_DATA_VOLUME=njord-data
NJORD_INSTALL_EXAMPLES=0
# Never enable this on an internet-facing installation. compose.local.yaml sets
# it only for the loopback demonstration.
NJORD_ALLOW_UNAUTHENTICATED=0

# GitHub OAuth public settings. nginx terminates HTTPS; Njord receives HTTP.
NJORD_ADMIN_GITHUB_LOGIN=
NJORD_GITHUB_CLIENT_ID=
NJORD_PUBLIC_URL=
# Production example:
# NJORD_ADMIN_GITHUB_LOGIN=elric1
# NJORD_GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
# NJORD_PUBLIC_URL=https://accounts.example.com

# Secret source files. Create each with mode 0600; never commit secrets/.
NJORD_POSTGRES_PASSWORD_FILE=./secrets/postgres_password
NJORD_GITHUB_CLIENT_SECRET_FILE=./secrets/github_client_secret
NJORD_SESSION_SECRET_FILE=./secrets/session_secret
NJORD_POSTGREST_JWT_SECRET_FILE=./secrets/postgrest_jwt_secret

# Optional resource/log limits
NJORD_MEMORY_LIMIT=2g
NJORD_CPU_LIMIT=2.0
NJORD_PIDS_LIMIT=256
NJORD_SHM_SIZE=128m
# Keep each resident PostgREST adapter to two Haskell runtime capabilities.
NJORD_GHCRTS=-N2
NJORD_LOG_MAX_SIZE=10m
NJORD_LOG_MAX_FILES=5
