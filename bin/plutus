#!/bin/sh

#
# We don't put all of this in a single SQL procedure, because
# PostgreSQL doesn't allow us to COPY FROM STDIN inside a procedure.
#
# We use a temp table to give us a chance to manipulate the
# data on the way in.  This makes the script slightly more
# complex.
#
# 
# XXXrcd: rename table?  scoping?
# XXXrcd: No comments in this SQL because it is interpreted
#         as a single line.
# XXXrcd: deal with starting imports as well as ongoing imports.

query() {
	FUNC_VS_VIEW="$1";	shift
	CMD="$1";		shift

	if [ "X$FUNC_VS_VIEW" = Xview -a $# -gt 0 ]; then
		usage "$CMD doesn't take any arguments"
	fi

	for arg; do
		if [ -z "$ARGS" ]; then
			ARGS="("
		else
			ARGS="$ARGS, "
		fi
		ARGS="$ARGS'$arg'"
	done
	if [ ! -z "$ARGS" ]; then
		ARGS="$ARGS)"
	fi

	if [ "X$FUNC_VS_VIEW" = Xfunc -a -z "$ARGS" ]; then
		ARGS="()"
	fi

	psql -c "SELECT * FROM $CMD$ARGS" finances | \
	    sed -E "s/(.{0,$COLUMNS}).*$/\\1/"
}

drop_db() {
	CMD="$1"

	psql -f $SQLFILES/drop.sql finances
}

init_db() {
	CMD="$1"

	psql -f $SQLFILES/plutus.sql finances
}

import_csv() {
	CMD="$1"
	INTO_ACCOUNT="$2"
	FROM_CSV="$3"

	IMPORT_PROGRAM="SET DATESTYLE = 'European';			\
									\
	CREATE TEMP TABLE import (					\
		date	VARCHAR,					\
		amt	VARCHAR,					\
		vendor	VARCHAR						\
	);								\
	COPY import(date, vendor, amt) FROM STDIN DELIMITER ',' CSV;	\
	CALL import_csv('$INTO_ACCOUNT');				\
	DROP TABLE import;"

	if [ -z "$FROM_CSV" ]; then
		FROM_CSV=-
	fi
	cat "$FROM_CSV"				| \
	    sed 's/$//'			| \
	    /usr/pkg/bin/psql -c "$IMPORT_PROGRAM" $DATABASE
}

usage() {

	if [ ! -z "$1" ]; then
		echo "ERROR: $1" 1>&2
	fi
	echo "usage: $PROGNAM [-d database] <cmd> [args]" 1>&2
	exit 2
}

#
# Set some global options up front:

COLUMNS=$(stty size | awk '{print $2}')
DATABASE=finances
PROGNAM="$0"
SQLFILES="/u/elric/tree/plutus/sql"

while getopts d: opt; do
	case "$opt" in
	-d)	DATABASE=$OPTARG;;
	\?)	usage;;
       esac
       shift
done
shift $(( OPTIND -1 ))

if [ $# -eq 0 ]; then
	usage "Command missing."
fi

CMD="$1"
shift

case "$CMD" in
drop_db)	;;
init_db)	;;
import_csv)	;;
fallthrough-shfunc)
	"$CMD" "$CMD" "$@"
	;;
bsheet)		;;
ledger)		;;
fallthrough-sqlfunc)
	query func "$CMD" "$@"
	;;
fallthrough-view)
	query view "$CMD" "$@"
	;;
*)	
	usage "command \"$CMD\" not implemented."
	;;
esac
