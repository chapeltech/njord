# Put this format in nginx's http block.  It logs the normalized path (`$uri`),
# never `$request` or `$args`, so OAuth code/state query values cannot enter the
# access log:
#
# log_format njord_no_args '$remote_addr - $remote_user [$time_local] '
#     '"$request_method $uri $server_protocol" $status $body_bytes_sent '
#     '"$http_referer" "$http_user_agent"';
#
# Include the access_log and location below in the existing HTTPS server for
# NJORD_PUBLIC_URL.
# Both Compose projects must join the external Docker network named by
# NJORD_DOCKER_NETWORK. nginx owns TLS; Njord deliberately speaks plain HTTP
# inside Docker.
# Apply the site's normal per-client connection and request limits here. Njord
# deliberately ignores X-Forwarded-For for identity and redirect decisions, so
# its built-in admission bounds protect the service globally rather than acting
# as the public per-IP rate limiter.
access_log /var/log/nginx/njord-access.log njord_no_args;

location / {
    proxy_pass http://njord:8080;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    client_max_body_size 2m;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
}
